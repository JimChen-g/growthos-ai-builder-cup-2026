# Leave blank in Firebase Hosting so /api uses the same-origin Cloud Run rewrite.
NEXT_PUBLIC_API_BASE_URL=

# Firebase web configuration is public by design. It identifies the Firebase project but does not
# grant backend access; Firestore rules and backend ID-token verification enforce authorization.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
