# Application
APP_ENV=development
# Required for any non-local access. Without it the API only answers loopback clients.
API_ACCESS_TOKEN=
API_PRINCIPAL_NAME=founder
# Hosted/public demo: serve the Demo workspace only and refuse every Live route.
PUBLIC_DEMO_ONLY=false
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_REQUIRED=false
COMPETITION_MODE=false
FIRESTORE_DATABASE=(default)
COMPETITION_SESSION_DAILY_LIMIT=20
COMPETITION_GLOBAL_DAILY_LIMIT=500
COMPETITION_MAX_EVIDENCE_ITEMS=30
COMPETITION_CACHE_TTL_SECONDS=86400
COMPETITION_DATA_RETENTION_DAYS=7
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_SOURCE_MODE=demo
DEMO_FIXTURE_PATH=data/demo_ai_customer_support.json
PHASE2_DEMO_FIXTURE_PATH=data/demo_phase2_slowing_growth.json
PHASE5_DEMO_FIXTURE_PATH=data/demo_phase5_polish.json
COMPANY_PROFILE_PATH=data/company_profile.example.json
ANALYSIS_DAYS=30
MARKET_DEMAND_SCORE=60
EXECUTION_CAPABILITY_SCORE=62.5

# Stripe (read-only secret key recommended)
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
STRIPE_API_BASE_URL=https://api.stripe.com

# Google Ads. Prefer the OAuth refresh token trio; a raw access token expires in ~1 hour.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_CONTAINS_EU_POLITICAL_ADVERTISING=false
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_CURRENCY=USD
GOOGLE_ADS_TARGET_ROAS=3.0
GOOGLE_ADS_TARGET_CAC=
GOOGLE_ADS_TARGET_CONVERSION_RATE_PCT=3.0

# Meta Ads (set the Graph API version supported by your Meta app)
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_API_VERSION=
META_ADS_API_BASE_URL=https://graph.facebook.com
META_ADS_CURRENCY=USD
META_ADS_TARGET_ROAS=3.0
META_ADS_TARGET_CAC=
META_ADS_TARGET_CONVERSION_RATE_PCT=3.0
# Optional override, comma-separated, first match wins (defaults cover purchases and leads).
# META_ADS_CONVERSION_ACTION_TYPES=offsite_conversion.fb_pixel_lead,lead

# Phase 3.1 grounded AI visibility providers. Keep every value server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Let Gemini phrase the briefing and the agent's reply from grounded facts (JSON schema bound).
# Scores, evidence and actions stay deterministic; failures fall back to template text.
GEMINI_NARRATION_ENABLED=false
GEMINI_NARRATION_MODEL=gemini-3.7-flash

# Vertex AI enterprise Gemini connection. Use an API key for testing or ADC in production.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
VERTEX_AI_API_KEY=
VERTEX_AI_MODEL=gemini-3.7-flash
VERTEX_AI_API_BASE_URL=https://aiplatform.googleapis.com
VERTEX_AI_REQUEST_TIMEOUT_SECONDS=40

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_API_BASE_URL=https://api.perplexity.ai

# X Recent Search. Reddit uses a Perplexity Search reddit.com domain filter.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
SOCIAL_REQUEST_TIMEOUT_SECONDS=12

# Phase 3.1 tenant connector controls.
GEO_REQUEST_TIMEOUT_SECONDS=45
GEO_DAILY_PROVIDER_QUOTA=50
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_VAULT_KEY=
CONNECTION_VAULT_PATH=data/private/connector_credentials.json.enc
# Phase 4.1 Injective EVM Testnet Proof Lab
DEMO_AUDIT_ANCHOR_RECEIPT_PATH=data/demo_injective_anchor_receipt.json
LIVE_AUDIT_ANCHOR_RECEIPT_PATH=data/private/live_injective_anchor_receipt.json
# Create the real ignored file with: npm --prefix blockchain run wallet:create
INJECTIVE_TESTNET_PRIVATE_KEY=
INJECTIVE_TESTNET_EVM_ADDRESS=
INJECTIVE_TESTNET_INJ_ADDRESS=
